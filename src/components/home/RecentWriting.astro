---
import { getPostHref, type PostEntry } from "../../lib/content/posts";

interface Props {
  posts: PostEntry[];
}

const { posts } = Astro.props;
---

<div class="recent-list">
  {posts.slice(0, 8).map((post) => (
    <a class="recent-item" href={getPostHref(post)}>
      <time class="recent-item__date" datetime={post.data.pubDate.toISOString()}>
        {post.data.pubDate.toISOString().slice(0, 10)}
      </time>
      <span class="recent-item__title">{post.data.title}</span>
      <span class="recent-item__tag">{post.data.categories[0] ?? "研究笔记"}</span>
    </a>
  ))}
</div>
