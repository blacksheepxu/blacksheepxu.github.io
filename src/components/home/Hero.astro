---
import { siteMeta } from "../../data/site";

interface Props {
  totalPosts: number;
  totalTopics: number;
  totalYears: number;
}

const { totalPosts, totalTopics } = Astro.props;
---

<section class="hero-compact panel">
  <div class="hero-compact__inner">
    <div class="hero-compact__copy">
      <h1>把研究、写作和实验放在同一个站里。</h1>
      <p>{siteMeta.description}</p>
    </div>
    <div class="hero-compact__stats">
      <span class="hero-stat"><strong>{totalPosts}</strong> 篇内容</span>
      <span class="hero-stat"><strong>{totalTopics}</strong> 个主题</span>
    </div>
    <a class="button button--primary" href="/blog">浏览内容</a>
  </div>
</section>
